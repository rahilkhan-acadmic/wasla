{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda execution role, function, and Function URL for the distress model inference API. Deploy AFTER pushing an image to the ECR repo from ecr-stack.json. Usage: aws cloudformation deploy --template-file aws/lambda-stack.json --stack-name distress-model-lambda --profile finance-distress --region ap-south-1 --capabilities CAPABILITY_NAMED_IAM --parameter-overrides ImageUri=<account-id>.dkr.ecr.ap-south-1.amazonaws.com/distress-model-api:latest",

  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "Description": "Full ECR image URI with tag, e.g. <account-id>.dkr.ecr.ap-south-1.amazonaws.com/distress-model-api:latest"
    },
    "DashboardOrigin": {
      "Type": "String",
      "Default": "",
      "Description": "CloudFront domain of the dashboard (dashboard-stack.json's DistributionDomainName output), e.g. d111111abcdef8.cloudfront.net. Left blank on first deploy before the dashboard stack exists -- CORS stays disabled until this is set via a redeploy with --parameter-overrides."
    }
  },

  "Conditions": {
    "HasDashboardOrigin": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "DashboardOrigin" }, ""] }] }
  },

  "Resources": {
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "distress-model-lambda-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "registry-read-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadModelFromS3",
                  "Effect": "Allow",
                  "Action": ["s3:GetObject"],
                  "Resource": { "Fn::Sub": "arn:aws:s3:::distress-model-${AWS::AccountId}/*" }
                },
                {
                  "Sid": "ReadRegistryPointer",
                  "Effect": "Allow",
                  "Action": ["dynamodb:GetItem"],
                  "Resource": { "Fn::Sub": "arn:aws:dynamodb:${AWS::Region}:${AWS::AccountId}:table/distress-model-registry" }
                }
              ]
            }
          }
        ]
      }
    },

    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "distress-model-api",
        "PackageType": "Image",
        "Code": {
          "ImageUri": { "Ref": "ImageUri" }
        },
        "Role": { "Fn::GetAtt": ["LambdaExecutionRole", "Arn"] },
        "Timeout": 60,
        "MemorySize": 1024,
        "ReservedConcurrentExecutions": 5,
        "Environment": {
          "Variables": {
            "MODEL_REGISTRY_TABLE": "distress-model-registry",
            "MODEL_BUCKET": { "Fn::Sub": "distress-model-${AWS::AccountId}" }
          }
        }
      }
    },

    "ApiFunctionUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": { "Ref": "ApiFunction" },
        "AuthType": "NONE",
        "Cors": {
          "Fn::If": [
            "HasDashboardOrigin",
            {
              "AllowOrigins": [{ "Fn::Sub": "https://${DashboardOrigin}" }],
              "AllowMethods": ["GET", "POST"],
              "AllowHeaders": ["content-type"],
              "MaxAge": 300
            },
            { "Ref": "AWS::NoValue" }
          ]
        }
      }
    },

    "ApiFunctionUrlPublicInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "ApiFunction" },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    }
  },

  "Outputs": {
    "FunctionArn": {
      "Description": "ARN of the deployed Lambda function",
      "Value": { "Fn::GetAtt": ["ApiFunction", "Arn"] }
    },
    "FunctionUrl": {
      "Description": "HTTPS endpoint for the API (public, AuthType NONE -- /predict's output isn't sensitive; ReservedConcurrentExecutions caps abuse/cost instead of gating with IAM)",
      "Value": { "Fn::GetAtt": ["ApiFunctionUrl", "FunctionUrl"] }
    }
  }
}
