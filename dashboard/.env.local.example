# Copy to .env.local for local dev against a real deployed API.
# In CI/deploy, this is passed as a build-time env var instead (static
# export bakes it in at `next build` time -- there's no server to read it
# at request time):
#   NEXT_PUBLIC_API_BASE_URL=https://xxxx.lambda-url.ap-south-1.on.aws npm run build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
